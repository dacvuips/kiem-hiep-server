# Chép thành deploy.env (đã .gitignore) — cho deploy/deploy.sh trên máy dev SSH lên VPS. Không chứa khóa bí mật.
# Đăng nhập VPS bằng SSH key (ssh-copy-id) để khỏi gõ mật khẩu nhiều lần.
# Tài khoản Docker Hub (repo kiemhiep-account, kiemhiep-game — nên để PRIVATE)
HUB=tenhub
VPS=root@1.2.3.4
SSH_PORT=22
REMOTE_DIR=/opt/kiemhiep
# Tên miền của API (đã trỏ DNS bản ghi A về IP VPS). Game + launcher phải có account_url = https://<DOMAIN>
DOMAIN=api.kiemhiep.vn
# Địa chỉ người chơi kết nối game server (tên miền trỏ về VPS hoặc IP)
GAME_HOST=game.kiemhiep.vn
# Repo game (cho deploy.sh game / client). Mặc định ../kiem-hiep
GAME_REPO=
