# Chép thành .env rồi điền khóa. KHÔNG commit file .env, KHÔNG đưa khóa vào client.
# Tạo bộ khóa mới:  docker compose run --rm --no-deps account genkeys
# (in ra JWT_KID, JWT_PRIVATE_KEY, PASSWORD_PEPPER, TOKEN_HMAC_KEY, DB_PASSWORD — dán đè các dòng dưới)

# --- Khóa bí mật (bắt buộc) ---
JWT_KID=DOI_THANH_KHOA_THAT
JWT_PRIVATE_KEY=DOI_THANH_KHOA_THAT
PASSWORD_PEPPER=DOI_THANH_KHOA_THAT
TOKEN_HMAC_KEY=DOI_THANH_KHOA_THAT
DB_PASSWORD=DOI_THANH_KHOA_THAT
# Game server dùng khóa này gọi API nội bộ /internal/* của account server.
GAME_SERVICE_KEY=DOI_THANH_KHOA_THAT

# Đổi khóa ký JWT: tạo khóa mới, đưa khóa CÔNG KHAI cũ vào đây ("kid:base64") để token cũ còn dùng tới khi hết hạn.
JWT_PUBLIC_KEYS=

# PASSWORD_PEPPER: KHÔNG được đổi khi đã có người chơi (đổi = mọi mật khẩu cũ sai). Phải sao lưu an toàn.

# --- Cấu hình ---
JWT_ISSUER=kiemhiep-account
JWT_AUDIENCE=kiemhiep-game
ACCESS_TTL=15m
REFRESH_TTL=720h
RESET_TTL=10m
# Tên miền web được gọi API từ trình duyệt (client web, web Admin). Ví dụ: https://admin.kiemhiep.vn,https://play.kiemhiep.vn
CORS_ORIGINS=http://localhost:5173
# true khi đứng sau reverse proxy HTTPS (Caddy/Nginx) để lấy đúng IP người chơi
TRUST_PROXY=false
MAIL_FROM=Kiếm Hiệp <no-reply@kiemhiep.local>
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: dịch vụ gửi mail thật khi chạy production

# --- Đăng nhập Google (bỏ trống = tắt) ---
# 1. https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID -> loại "Web application"
# 2. Authorized redirect URIs: <PUBLIC_BASE_URL>/v1/auth/google/callback  (dev: http://localhost:8080/v1/auth/google/callback)
# 3. Dán Client ID + Client secret vào đây. Client secret CHỈ nằm ở server, không bao giờ đưa vào game.
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie phiên web Admin chỉ gửi qua HTTPS. Chỉ đặt false khi chạy dev bằng http://.
ADMIN_COOKIE_SECURE=true

# Super Admin đầu tiên (chỉ tạo khi chưa có admin nào). Đăng nhập xong hãy đổi mật khẩu + bật 2FA.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASS=DOI_THANH_KHOA_THAT

# Giới hạn yêu cầu / phút theo IP (mặc định 120). Chỉ tăng tạm khi chạy load test trên máy dev.
RATE_LIMIT_IP_PER_MIN=120

# Nạp thẻ: cổng thanh toán GIẢ LẬP (chỉ bật khi phát triển; production để false và cắm cổng thật)
SHOP_SANDBOX=false

# --- CHỈ KHI PHÁT TRIỂN — TUYỆT ĐỐI không bật trên máy chủ thật (người chơi tự sửa được cấp / tiền / đồ) ---
# true / 1 = server lưu nguyên dữ liệu nhân vật game gửi: nút TEST lên cấp, thêm đồ, cộng điểm ở Hub / trong map được lưu thật.
# Mặc định TẮT (an toàn khi chép file này lên máy thật). Máy dev muốn dùng nút TEST: đổi thành true / 1 trong .env của máy dev.
DEV_TRUST_CLIENT_SAVES=false
GAME_DEV_TRUST_CLIENT=0

# --- Máy dev (server/dev.sh) ---
# Đường dẫn Godot (build gói game server, chạy server bằng Godot): VD /c/Users/ten/Downloads/Godot_v4.7.2-stable_win64_console.exe
GODOT_PATH=
# Địa chỉ người chơi kết nối tới các game server (báo qua /v1/battle, /v1/arena, /v1/field). Máy thật: IP / tên miền công khai.
GAME_PUBLIC_HOST=127.0.0.1
# API tài khoản + web Admin chỉ nghe trên máy này (127.0.0.1). Thử từ điện thoại trong LAN: 0.0.0.0. Máy thật: giữ 127.0.0.1 + reverse proxy HTTPS.
ACCOUNT_BIND=127.0.0.1
